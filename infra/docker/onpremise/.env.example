# ================================================================
# 온프레미스(고객사) .env 예시(example) (UG-320)
# 실제 파일 위치: {WORKING_DIR}/.env (UG-247 표준 구조)
#
# ⚠️ <SECRET> 표시 값은 git 에 저장하지 않는다. 실제 값은 고객사 서버의 .env 에만 존재.
# ⚠️ 이 파일은 고객사 공통 템플릿이다. 납품 구성에 없는 레이어는 COMPOSE_FILE 에서 지운다.
#
# master/.env.example 과 다른 점 (폐쇄망 전제):
#   - CONFIG_SERVER_PROFILE=native   GitHub 에서 gate-config 를 클론할 수 없다
#   - CORE_SPRING_PROFILES_ACTIVE 에 onpremise 포함
#   - 오라클 기본, 서비스마다 계정 분리 (UG-296)
#   - GMAIL 값 없음 — onpremise 프로파일은 mail.enabled: false 다
#   - AUTH_BOOTSTRAP_* — 최초 관리자 부트스트랩 (UMS-3)
#
# 설치 절차: docs/onpremise-admin-bootstrap.md, docs/onpremise-oracle-setup.md
# ================================================================

# ================================================================
# Compose 레이어 조합 (UG-246)
# 납품하지 않는 레이어는 지운다. 아래는 gate 풀세트 예시다.
# ================================================================
COMPOSE_PROJECT_NAME=gate
COMPOSE_FILE=compose.core.yml:compose.infra.yml:compose.auth.yml:compose.notify.yml:compose.face.yml:compose.palm.yml:compose.gate.yml:compose.gate-web.yml

# 호스트 포트 — 고객사 방화벽·기존 점유 상황에 맞춰 조정한다
POSTGRES_HOST_PORT=7432
REDIS_HOST_PORT=7379
CONFIG_HOST_PORT=7888
DISCOVERY_HOST_PORT=7761
GATEWAY_HOST_PORT=7080
FXP_HOST_PORT=7947
GATE_WEB_HOST_PORT=7751

# Dockhub URL
# 폐쇄망에서는 사내 레지스트리로 이미지를 반입한 뒤 그 주소를 넣는다.
DOCKHUB_GATE_URL=<사내 레지스트리>/univs-gate
DOCKHUB_POINT_URL=<사내 레지스트리>/univs-point

# ================================================================
# Database — 오라클 (UG-296)
# 오라클은 계정과 스키마가 1:1 이라 서비스마다 계정을 따로 판다. 한 계정을 나눠 쓰면
# flyway_schema_history 를 공유하게 되고 두 번째로 뜨는 서비스가 V1 체크섬 불일치로
# 기동에 실패한다.
#
# CORE_DB_URL 은 뒤에 DB 이름을 붙이는 PostgreSQL 형태라 오라클에는 쓸 수 없다.
# 반드시 {서비스}_DB_URL 로 전체 URL 을 준다.
#
# 계정 생성 DDL 과 대상 버전(19c): docs/onpremise-oracle-setup.md
# ================================================================
AUTH_DB_URL=jdbc:oracle:thin:@//<오라클 호스트>:1521/<서비스명>
AUTH_DB_USERNAME=univs_auth
AUTH_DB_PASSWORD=<SECRET>

GATE_DB_URL=jdbc:oracle:thin:@//<오라클 호스트>:1521/<서비스명>
GATE_DB_USERNAME=univs_gate
GATE_DB_PASSWORD=<SECRET>

FACE_DB_URL=jdbc:oracle:thin:@//<오라클 호스트>:1521/<서비스명>
FACE_DB_USERNAME=univs_face
FACE_DB_PASSWORD=<SECRET>

MATCH_DB_URL=jdbc:oracle:thin:@//<오라클 호스트>:1521/<서비스명>
MATCH_DB_USERNAME=univs_match
MATCH_DB_PASSWORD=<SECRET>

PALM_DB_URL=jdbc:oracle:thin:@//<오라클 호스트>:1521/<서비스명>
PALM_DB_USERNAME=univs_palm
PALM_DB_PASSWORD=<SECRET>

# 오라클을 쓰면 compose.infra.yml 의 platform-postgresql 은 필요 없다.
# CORE_DB_* 는 어느 서비스도 참조하지 않게 되지만, compose 의 기본값 치환
# (${AUTH_DB_URL:-${CORE_DB_URL}/auth})이 참조하므로 빈 값으로 남겨 둔다.
CORE_DB_URL=
CORE_DB_USERNAME=
CORE_DB_PASSWORD=

# Cash Store - Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<SECRET>

# Frontend dockhub image version
GATE_WEB_VERSION=<납품 버전>

# Backend dockhub image version
# 납품 시점에 고정한다. 폐쇄망은 자동 갱신이 없으므로 반입한 이미지 태그와 정확히 맞춘다.
DISCOVERY_SERVER_VERSION=<납품 버전>
CONFIG_SERVER_VERSION=<납품 버전>
GATEWAY_SERVER_VERSION=<납품 버전>
AUTH_SERVICE_VERSION=<납품 버전>
FACE_SERVICE_VERSION=<납품 버전>
MATCH_SERVER_VERSION=<납품 버전>
FXP_PREPROCESS_SERVICE_VERSION=<납품 버전>
GATE_SERVICE_VERSION=<납품 버전>
NOTIFY_SERVICE_VERSION=<납품 버전>
PALM_SERVICE_VERSION=<납품 버전>

## Backend env
# onpremise 프로파일이 있어야 관리자 초기화 API 와 mail.enabled: false 가 활성화된다.
SPRING_PROFILES_ACTIVE=prod, onpremise
CORE_SPRING_PROFILES_ACTIVE=prod, oracle, onpremise

# ================================================================
# Config server — native (폐쇄망)
# git 프로파일은 GitHub 에서 gate-config 를 클론하므로 폐쇄망에서 쓸 수 없다.
# gate-config 를 미리 클론해 {WORKING_DIR}/spring-config/ 에 두고 마운트한다 (UG-233).
# ================================================================
CONFIG_SERVER_PROFILE=native
GIT_USERNAME=
GIT_PASSWORD=

# Management port
MANAGEMENT_SERVER_PORT=9001

# File
FILE_API_ENDPOINT_GET=/api/v1/file
FILE_ENABLE_UPLOAD=true
FILE_ROOT_PATH=/var/uploads
FILE_SECRET_KEY=<SECRET>
FILE_ALGORITHM_WAY=AES
FILE_ALGORITHM_MOD=AES/ECB/PKCS5Padding

# JWT secret key
# 고객사마다 새로 생성한다. base64 여야 한다 (jjwt 가 base64 로 디코딩한다).
#   openssl rand -base64 48
JWT_SECRET=<SECRET>
JWT_CREATE_USER_TOKEN_EXPIRY=300000
JWT_ACCESS_TOKEN_EXPIRY=900000
JWT_REFRESH_TOKEN_EXPIRY=604800000

# ================================================================
# 최초 관리자 부트스트랩 (UG-320 / msa-scaffold UMS-3)
#
# INSTALL_TOKEN 이 비어 있으면 관리자 초기화 API 가 통째로 막힌다(fail closed).
# 설치 담당자가 매 설치마다 새로 생성한다.
#   openssl rand -hex 16
#
# 유효 창은 서비스 기동 시점부터 30분이다. 놓쳤으면 auth-service 를 재시작하면 창이
# 다시 열린다 — 이미 초기화된 뒤에는 창이 열려도 무해하다.
#
# 비밀번호는 고객사 담당자가 초기화 화면에서 직접 입력한다. 설치가 끝난 시점에
# 우리는 고객 관리자 비밀번호를 모른다. 절차: docs/onpremise-admin-bootstrap.md
# ================================================================
AUTH_BOOTSTRAP_INSTALL_TOKEN=<SECRET: openssl rand -hex 16>

# 최초 관리자에게 함께 부여할 제품 역할. 비우면 관리 권한만 갖고 시작하고,
# 제품 역할은 관리 화면에서 스스로 부여한다. 형식: app:ROLE (쉼표 구분)
AUTH_BOOTSTRAP_ADMIN_APP_ROLES=gate:ADMIN

# 테넌트 코드. 비우면 default. 고객사 식별자를 넣어 두면 나중에 클라우드로 옮길 때 유용하다.
AUTH_BOOTSTRAP_TENANT_CODE=

# 클라우드 승격 경로 — 온프레미스에서는 쓰지 않는다 (초기화 API 가 그 역할을 한다).
AUTH_BOOTSTRAP_ADMIN_EMAIL=

# URL
# 폐쇄망 내부 주소로 채운다. 공개 도메인을 남기면 기동은 되지만 동작하지 않는다.
WEB_SOCKET_ALLOW_ORIGINS=<내부 웹소켓 오리진>
PALM_MODULE_URL=<내부 palm 주소>
GATEWAY_URL=<내부 게이트웨이 주소>
